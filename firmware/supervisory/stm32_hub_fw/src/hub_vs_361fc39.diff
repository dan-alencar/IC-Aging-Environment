diff -ruN --strip-trailing-cr 361fc39_Core/Src/fpga_link.c hub_Core/Src/fpga_link.c
--- 361fc39_Core/Src/fpga_link.c	1969-12-31 21:00:00.000000000 -0300
+++ hub_Core/Src/fpga_link.c	2026-11-05 15:19:21.435875588 -0300
@@ -0,0 +1,126 @@
+/******************************************************************************
+ * @file    fpga_link.c
+ * @brief   Arquitetura B: enlace FPGA → STM32 → PC. Ver fpga_link.h.
+ *****************************************************************************/
+#include "fpga_link.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include "main.h"
+#include "cmsis_os.h"
+#include "Serial_Bridge.h"
+#include "telemetry.h"
+
+#define FL_QUEUE        4u
+#define FL_FLAG_FRAME   0x0001u
+#define HELLO_PERIOD_MS 1000u
+#define FWV_PERIOD_MS   5000u     /* o app espera até 20 s pelo $FWV antes de avisar */
+
+typedef struct {
+    uint16_t len;
+    uint32_t tick;
+    uint8_t  data[FL_MAX_FWD_FRAME];
+} fl_slot_t;
+
+static fl_asm_t           s_asm;
+static fl_slot_t          s_q[FL_QUEUE];
+static volatile uint8_t   s_qw, s_qr;
+static volatile osThreadId_t s_task;
+
+void FPGA_Link_Init(void)
+{
+    fl_asm_init(&s_asm);
+    s_qw = s_qr = 0u;
+    s_task = NULL;
+}
+
+/* Interrupção da USART1 (DMA de 1 byte). Só remonta e enfileira. */
+void FPGA_Link_Rx_Byte(uint8_t b)
+{
+    uint16_t n = fl_asm_feed(&s_asm, b, HAL_GetTick());
+    if (n == 0u) {
+        return;
+    }
+    if (n > FL_MAX_FWD_FRAME) {
+        s_asm.c.hdr_err++;
+        return;
+    }
+    uint8_t next = (uint8_t)((s_qw + 1u) % FL_QUEUE);
+    if (next == s_qr) {
+        s_asm.c.queue_drop++;
+        return;
+    }
+    fl_slot_t *slot = &s_q[s_qw];
+    slot->len = n;
+    slot->tick = HAL_GetTick();
+    memcpy(slot->data, s_asm.buf, n);
+    s_qw = next;
+    if (s_task != NULL) {
+        osThreadFlagsSet((osThreadId_t)s_task, FL_FLAG_FRAME);
+    }
+}
+
+void FPGA_Link_Uart_Error(void)
+{
+    s_asm.c.uart_err++;
+    s_asm.pos = 0u;
+}
+
+void FPGA_Link_Get_Counters(fl_counters_t *out)
+{
+    uint32_t primask = __get_PRIMASK();
+    __disable_irq();
+    *out = s_asm.c;
+    __set_PRIMASK(primask);
+}
+
+static void send_fwv(void)
+{
+    static char payload[128];
+    static char line[160];
+    const uint32_t *uid = (const uint32_t *)UID_BASE;
+    snprintf(payload, sizeof(payload), "Fw,%s,Ver,%s,Base,%s,Build,%s,Uid,%08lX%08lX%08lX",
+             HUB_FW_NAME, HUB_FW_VERSION, HUB_FW_BASE, HUB_FW_BUILD,
+             (unsigned long)uid[0], (unsigned long)uid[1], (unsigned long)uid[2]);
+    int n = fl_format_line(line, sizeof(line), "FWV", payload);
+    if (n > 0) {
+        Telemetry_Send_Line(line, (uint16_t)n);
+    }
+}
+
+void FPGA_Link_Task(void *argument)
+{
+    (void)argument;
+    static char line[256];
+    fl_counters_t c;
+    s_task = osThreadGetId();
+    uint32_t next_hello = HAL_GetTick();
+    uint32_t next_fwv = HAL_GetTick();
+
+    for (;;) {
+        uint32_t now = HAL_GetTick();
+        if ((int32_t)(now - next_hello) >= 0) {
+            Bridge_Send_Hello();
+            next_hello = now + HELLO_PERIOD_MS;
+        }
+        if ((int32_t)(now - next_fwv) >= 0) {
+            send_fwv();
+            next_fwv = now + FWV_PERIOD_MS;
+        }
+        while (s_qr != s_qw) {
+            fl_slot_t *slot = &s_q[s_qr];
+            FPGA_Link_Get_Counters(&c);
+            int n = fl_format_fpg(line, sizeof(line), slot->tick, &c, slot->data, slot->len);
+            s_qr = (uint8_t)((s_qr + 1u) % FL_QUEUE);
+            if (n > 0) {
+                Telemetry_Send_Line(line, (uint16_t)n);
+            }
+        }
+        int32_t wait = (int32_t)(next_hello - HAL_GetTick());
+        if (wait < 1) {
+            wait = 1;
+        }
+        osThreadFlagsWait(FL_FLAG_FRAME, osFlagsWaitAny, (uint32_t)wait);
+    }
+}
diff -ruN --strip-trailing-cr 361fc39_Core/Src/fpga_link_core.c hub_Core/Src/fpga_link_core.c
--- 361fc39_Core/Src/fpga_link_core.c	1969-12-31 21:00:00.000000000 -0300
+++ hub_Core/Src/fpga_link_core.c	2026-11-05 15:19:21.435844369 -0300
@@ -0,0 +1,138 @@
+/******************************************************************************
+ * @file    fpga_link_core.c
+ * @brief   Remontagem dos quadros v2 do FPGA e formatação da linha $FPG.
+ *          Ver fpga_link_core.h. Sem HAL nem RTOS.
+ *****************************************************************************/
+#include "fpga_link_core.h"
+
+#include <stdio.h>
+#include <string.h>
+
+uint16_t fl_crc16_update(uint16_t crc, uint8_t b)
+{
+    crc ^= b;
+    for (int i = 0; i < 8; i++) {
+        crc = (crc & 1u) ? (uint16_t)((crc >> 1) ^ 0xA001u) : (uint16_t)(crc >> 1);
+    }
+    return crc;
+}
+
+uint16_t fl_crc16(const uint8_t *d, uint16_t n)
+{
+    uint16_t crc = 0xFFFFu;
+    for (uint16_t i = 0; i < n; i++) {
+        crc = fl_crc16_update(crc, d[i]);
+    }
+    return crc;
+}
+
+void fl_asm_init(fl_asm_t *a)
+{
+    memset(a, 0, sizeof(*a));
+}
+
+uint16_t fl_asm_feed(fl_asm_t *a, uint8_t b, uint32_t now_ms)
+{
+    if (a->pos != 0u && (uint32_t)(now_ms - a->last_ms) > FL_GAP_MS) {
+        a->c.gaps++;                          /* quadro cortado: o resto não vem mais */
+        a->pos = 0u;
+    }
+    a->last_ms = now_ms;
+
+    if (a->pos == 0u) {
+        if (b == FL_SYNC0) {
+            a->buf[0] = b;
+            a->pos = 1u;
+        } else {
+            a->c.junk++;
+        }
+        return 0u;
+    }
+    if (a->pos == 1u) {
+        if (b == FL_SYNC1) {
+            a->buf[1] = b;
+            a->pos = 2u;
+            a->crc = 0xFFFFu;
+        } else if (b == FL_SYNC0) {
+            a->c.junk++;                      /* A5 A5 5A …: o segundo A5 pode ser o início */
+        } else {
+            a->c.junk += 2u;
+            a->pos = 0u;
+        }
+        return 0u;
+    }
+
+    uint16_t i = a->pos;
+    a->buf[i] = b;
+    a->pos = (uint16_t)(i + 1u);
+
+    if (i < FL_HDR_LEN) {                   /* VER, TYPE, SEQ, LEN */
+        a->crc = fl_crc16_update(a->crc, b);
+        if (i == FL_HDR_LEN - 1u) {
+            if (a->buf[2] != FL_VERSION || b > FL_MAX_PAYLOAD) {
+                a->c.hdr_err++;
+                a->pos = 0u;
+                return 0u;
+            }
+            a->need = (uint16_t)(FL_HDR_LEN + b + FL_CRC_LEN);
+        }
+        return 0u;
+    }
+    if (i < a->need - FL_CRC_LEN) {         /* payload */
+        a->crc = fl_crc16_update(a->crc, b);
+        return 0u;
+    }
+    if (a->pos < a->need) {                 /* primeiro byte do CRC */
+        return 0u;
+    }
+    a->pos = 0u;                            /* quadro completo */
+    uint16_t rx = (uint16_t)(a->buf[a->need - 2u] | (a->buf[a->need - 1u] << 8));
+    if (rx != a->crc) {
+        a->c.crc_err++;
+        return 0u;
+    }
+    a->c.frames_ok++;
+    return a->need;
+}
+
+static int append_checksum(char *out, size_t cap, int len)
+{
+    uint8_t cs = 0;
+    for (int i = 1; i < len; i++) {         /* tudo depois do '$' */
+        cs ^= (uint8_t)out[i];
+    }
+    if ((size_t)len + 4u > cap) {
+        return -1;
+    }
+    int n = snprintf(out + len, cap - (size_t)len, "*%02X", cs);
+    return (n == 3) ? len + 3 : -1;
+}
+
+int fl_format_line(char *out, size_t cap, const char *kind, const char *payload)
+{
+    int len = snprintf(out, cap, "$%s,%s", kind, payload);
+    if (len <= 0 || (size_t)len >= cap) {
+        return -1;
+    }
+    return append_checksum(out, cap, len);
+}
+
+int fl_format_fpg(char *out, size_t cap, uint32_t tick_ms, const fl_counters_t *c,
+                  const uint8_t *frame, uint16_t len)
+{
+    static const char hex[] = "0123456789ABCDEF";
+    int n = snprintf(out, cap, "$FPG,Tk,%lu,Ok,%lu,Ce,%lu,He,%lu,Ue,%lu,Qd,%lu,Gp,%lu,Jk,%lu,Hx,",
+                     (unsigned long)tick_ms, (unsigned long)c->frames_ok,
+                     (unsigned long)c->crc_err, (unsigned long)c->hdr_err,
+                     (unsigned long)c->uart_err, (unsigned long)c->queue_drop,
+                     (unsigned long)c->gaps, (unsigned long)c->junk);
+    if (n <= 0 || (size_t)n + 2u * len + 4u > cap) {
+        return -1;
+    }
+    for (uint16_t i = 0; i < len; i++) {
+        out[n++] = hex[frame[i] >> 4];
+        out[n++] = hex[frame[i] & 0x0Fu];
+    }
+    out[n] = '\0';
+    return append_checksum(out, cap, n);
+}
