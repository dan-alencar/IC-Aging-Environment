# Fixed placement and routing of the aged logic of fbs_aging_top (fbs SPEC V19).
#
# The slack baseline of every chain depends on where its cells sit and how its nets are routed,
# and also on the clock tree that drives its sensor. A rebuild that moves any of it shifts the
# baselines, so a run's bitstream could never be rebuilt. These procedures lock all of it:
#   - every primitive under u_fabric (chains, sensors FF1/FF2/XOR1/FF3, ring oscillators,
#     the stress synchronisers): LOC, BEL and, for LUTs, LOCK_PINS;
#   - every net whose pins are all under u_fabric: FIXED_ROUTE (directed routing, UG903);
#   - the MMCM, the three BUFGCEs of the measurement clocks and their clock roots.
# Placement alone is not enough: the colleague's multi-chain design fixed the sensor cells by
# XDC and its baselines still moved between builds, because the adder routing changed.
#
#   fbs_aging_write_fixed_xdc FILE   from an open routed design (scripts/extract_fbs_aging_pnr.sh)
#   fbs_aging_report_chains FILE     per-chain delays and slack, for comparing builds
#   fbs_aging_dump_fabric FILE       every locked LOC/BEL/pin map/route, sorted, for diff/md5sum

set ::fbs_aging_phase_step_ns 0.019841   ;# MMCM phase step (19 841 fs, AGING_INFO)

proc fbs_aging_fabric_cells {} {
  return [lsort [get_cells -hier -quiet -filter {NAME =~ u_fabric/* && IS_PRIMITIVE && REF_NAME !~ GND && REF_NAME !~ VCC}]]
}

proc fbs_aging_clock_cells {} {
  return [lsort [concat [get_cells -quiet u_clocks/u_mmcm] [get_cells -quiet u_clocks/* -filter {REF_NAME =~ BUFG*}]]]
}

# the measurement clock nets: MMCM outputs to the BUFGCEs, and the BUFGCE outputs
proc fbs_aging_clock_nets {} {
  set nets {}
  foreach b [lsort [get_cells -quiet u_clocks/* -filter {REF_NAME =~ BUFG*}]] {
    lappend nets [get_nets -of [get_pins $b/I]] [get_nets -of [get_pins $b/O]]
  }
  return $nets
}

# nets with every leaf pin under u_fabric, routed, not power or ground
proc fbs_aging_fabric_nets {} {
  set nets {}
  foreach n [lsort -unique [get_nets -quiet -of [get_pins -quiet -of [fbs_aging_fabric_cells]]]] {
    if {[get_property TYPE $n] ne "SIGNAL"} { continue }
    set inside 1
    foreach p [get_pins -quiet -leaf -of $n] {
      if {![string match u_fabric/* $p]} { set inside 0; break }
    }
    if {[llength [get_ports -quiet -of $n]] > 0} { set inside 0 }
    if {$inside} { lappend nets $n }
  }
  return $nets
}

# "I0:A5 I1:A3" from the placed LUT's BEL pins
proc fbs_aging_lut_pin_map {cell} {
  set map {}
  foreach p [lsort [get_pins -quiet -of $cell -filter {DIRECTION == IN}]] {
    set bp [get_bel_pins -quiet -of $p]
    if {$bp eq ""} { continue }
    lappend map "[get_property REF_PIN_NAME $p]:[lindex [split $bp /] end]"
  }
  return [join $map " "]
}

proc fbs_aging_write_fixed_xdc {file} {
  set cells [fbs_aging_fabric_cells]
  set nets  [fbs_aging_fabric_nets]
  set f [open $file w]
  puts $f "## fbs_aging_top: fixed placement and routing of the aged logic (fbs SPEC V19)."
  puts $f "## GENERATED by scripts/extract_fbs_aging_pnr.sh from a routed checkpoint; do not edit."
  puts $f "## Source design: [get_property TOP [current_design]], part [get_property PART [current_design]], Vivado [version -short]"
  puts $f "## Read by scripts/build_fbs_aging.tcl after synthesis (FBS_AGING_FREE_PNR=1 skips it)."
  puts $f "## [llength [fbs_aging_clock_cells]] clock cells, [llength $cells] fabric cells, [llength $nets] fabric nets\
 (the ones with interconnect get a FIXED_ROUTE; intra-site nets and nets without loads have none)."
  puts $f ""
  puts $f "## Measurement clocks: MMCM, BUFGCEs and clock roots"
  foreach c [fbs_aging_clock_cells] {
    puts $f "set_property LOC [get_property LOC $c] \[get_cells {$c}\]"
  }
  foreach b [get_cells -quiet u_clocks/* -filter {REF_NAME =~ BUFG*}] {
    set n [get_nets -of [get_pins $b/O]]
    set root [get_property CLOCK_ROOT $n]
    if {$root ne ""} {
      puts $f "set_property USER_CLOCK_ROOT $root \[get_nets -of \[get_pins {$b/O}\]\]"
    }
  }
  # the clock routes themselves (MMCM -> BUFGCE, BUFGCE -> the sensors): the clock router can
  # otherwise pick other tracks, which moved the sensor skew by up to 6 ps in a test build
  foreach n [fbs_aging_clock_nets] {
    set r [string trim [get_property ROUTE $n]]
    if {$r ne ""} { puts $f "set_property FIXED_ROUTE {$r} \[get_nets {$n}\]" }
  }
  puts $f ""
  puts $f "## Fabric cells: BEL, LOC, LUT pin maps"
  foreach c $cells {
    set loc [get_property LOC $c]
    if {$loc eq ""} { error "fbs_aging_write_fixed_xdc: $c is not placed (is the checkpoint routed?)" }
    set bel [lindex [split [get_property BEL $c] .] end]
    puts $f "set_property BEL $bel \[get_cells {$c}\]"
    puts $f "set_property LOC $loc \[get_cells {$c}\]"
    if {[string match LUT* [get_property REF_NAME $c]]} {
      set m [fbs_aging_lut_pin_map $c]
      if {$m ne ""} { puts $f "set_property LOCK_PINS {$m} \[get_cells {$c}\]" }
    }
  }
  puts $f ""
  puts $f "## Fabric nets: directed routes"
  set unrouted 0
  set nroutes 0
  foreach n $nets {
    set st [get_property ROUTE_STATUS $n]
    set r [string trim [get_property ROUTE $n]]
    if {$st ne "ROUTED" || $r eq ""} {
      # intra-site nets (e.g. a LUT to the FF beside it) have no interconnect to fix, and
      # nets without loads (the unused CARRY8 outputs) have no route at all
      if {$st ni {INTRASITE NOLOADS}} { puts "fbs_aging_write_fixed_xdc: $n is $st"; incr unrouted }
      continue
    }
    puts $f "set_property FIXED_ROUTE {$r} \[get_nets {$n}\]"
    incr nroutes
  }
  close $f
  if {$unrouted > 0} { error "fbs_aging_write_fixed_xdc: $unrouted fabric nets are not fully routed" }
  puts "fbs_aging_write_fixed_xdc: [llength $cells] cells, [llength $nets] nets ($nroutes routes) -> $file"
}

proc fbs_aging_path_field {to kind field} {
  set p [get_timing_paths -quiet -to $to -$kind -max_paths 1 -nworst 1]
  if {$p eq ""} { return "-" }
  set v [get_property $field $p]
  return [expr {$v eq "" ? "-" : $v}]
}

# One line per chain. Two builds with identical lines have identical baselines (up to the
# silicon); slack_ff1 / phase step is the predicted sweep count at this corner.
proc fbs_aging_report_chains {file} {
  set f [open $file w]
  puts $f "# fbs_aging_top chain timing ([get_property PART [current_design]], Vivado [version -short], slow corner setup / fast corner hold)"
  puts $f "# ff2_delay / ff2_delay_min: data path to FF2/D (clk_meas), setup and hold analysis, ns"
  puts $f "# ff1_slack / ff1_skew: setup slack and clock skew to FF1/D (clk_phase, phase 0), ns; steps = ff1_slack / 19.841 ps"
  puts $f [format "%-5s %-9s %9s %13s %9s %9s %9s %6s %-16s" chain ff2_loc ff2_delay ff2_delay_min ff2_slack ff1_slack ff1_skew steps ff1_loc]
  set i 0
  while {[llength [get_cells -quiet "u_fabric/g_chain\[$i\].FF1"]] == 1} {
    set ff1 [get_cells "u_fabric/g_chain\[$i\].FF1"]
    set ff2 [get_cells "u_fabric/g_chain\[$i\].FF2"]
    set d1 [get_pins $ff1/D]
    set d2 [get_pins $ff2/D]
    set s1 [fbs_aging_path_field $d1 setup SLACK]
    set steps [expr {$s1 eq "-" ? "-" : int(floor($s1 / $::fbs_aging_phase_step_ns))}]
    puts $f [format "%-5d %-9s %9s %13s %9s %9s %9s %6s %-16s" $i [get_property LOC $ff2] \
      [fbs_aging_path_field $d2 setup DATAPATH_DELAY] [fbs_aging_path_field $d2 hold DATAPATH_DELAY] \
      [fbs_aging_path_field $d2 setup SLACK] $s1 [fbs_aging_path_field $d1 setup SKEW] $steps [get_property LOC $ff1]]
    incr i
  }
  set cells [fbs_aging_fabric_cells]
  set fixed_cells [llength [filter $cells {IS_LOC_FIXED && IS_BEL_FIXED}]]
  set nets [fbs_aging_fabric_nets]
  set routed [filter $nets {ROUTE_STATUS == ROUTED}]
  set fixed_nets [llength [filter $routed {IS_ROUTE_FIXED}]]
  puts $f "# fabric cells [llength $cells] (LOC and BEL fixed: $fixed_cells); fabric nets [llength $nets],\
 [llength $routed] with interconnect (route fixed: $fixed_nets)"
  foreach c [fbs_aging_clock_cells] { puts $f "# clock cell $c [get_property LOC $c]" }
  close $f
}

# Everything the fixed XDC locks, as the router left it. Identical dumps = identical aged logic.
proc fbs_aging_dump_fabric {file} {
  set f [open $file w]
  foreach c [fbs_aging_clock_cells] { puts $f "C $c [get_property LOC $c]" }
  foreach b [get_cells -quiet u_clocks/* -filter {REF_NAME =~ BUFG*}] {
    puts $f "R $b [get_property CLOCK_ROOT [get_nets -of [get_pins $b/O]]]"
  }
  foreach c [fbs_aging_fabric_cells] {
    set m [expr {[string match LUT* [get_property REF_NAME $c]] ? [fbs_aging_lut_pin_map $c] : ""}]
    puts $f "B $c [get_property LOC $c] [get_property BEL $c] $m"
  }
  foreach n [fbs_aging_clock_nets] { puts $f "K $n [string trim [get_property ROUTE $n]]" }
  foreach n [fbs_aging_fabric_nets] { puts $f "N $n [string trim [get_property ROUTE $n]]" }
  close $f
}

# the data rows of a chains.txt (comments dropped), for comparing two builds
proc fbs_aging_chain_rows {file} {
  set rows {}
  foreach l [split [read [set fh [open $file]]] "\n"] {
    if {$l ne "" && ![string match "#*" $l]} { lappend rows $l }
  }
  close $fh
  return $rows
}
