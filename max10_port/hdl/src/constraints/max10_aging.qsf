# ============================================================================
# max10_aging.qsf -- atribuicoes de pino e assignments de dispositivo para a
# demonstracao de viabilidade da regua de fase (PLL dinamico) na DE10-Lite.
#
# Referencia: DE10-Lite User Manual (Terasic), tabela de pinout.
# Dispositivo: 10M50DAF484C7G
# ============================================================================

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY max10_aging_top

# Clock de entrada: MAX10_CLK1_50 (oscilador on-board, 50 MHz)
set_location_assignment PIN_P11 -to clk50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk50

# Reset: KEY0 (botao fisico, ativo em nivel baixo)
set_location_assignment PIN_B8 -to cpu_resetn
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cpu_resetn

# LEDs de status/debug
set_location_assignment PIN_A8  -to pll_locked      ; # LEDR0
set_location_assignment PIN_A9  -to alarm           ; # LEDR1
set_location_assignment PIN_A10 -to calibrated      ; # LEDR2
set_location_assignment PIN_B10 -to dbg_phasedone   ; # LEDR3
set_location_assignment PIN_D13 -to dbg_idle        ; # LEDR4
set_location_assignment PIN_C13 -to dbg_step        ; # LEDR5
set_location_assignment PIN_E14 -to dbg_wait_low    ; # LEDR6 (S_COOLDOWN)
set_location_assignment PIN_D14 -to dbg_wait_high   ; # LEDR7
set_location_assignment PIN_A11 -to dbg_done        ; # LEDR8
set_location_assignment PIN_B11 -to dbg_alarm_sync  ; # LEDR9

# UART TX (adaptador USB-TTL externo, ou futura ponte para ESP32)
set_location_assignment PIN_V10 -to uart_txd        ; # GPIO_[0]

# Display de 7 segmentos: slack_count[7:0] em hexadecimal (2 digitos)
set_location_assignment PIN_C14 -to hex0[0]
set_location_assignment PIN_E15 -to hex0[1]
set_location_assignment PIN_C15 -to hex0[2]
set_location_assignment PIN_C16 -to hex0[3]
set_location_assignment PIN_E16 -to hex0[4]
set_location_assignment PIN_D17 -to hex0[5]
set_location_assignment PIN_C17 -to hex0[6]

set_location_assignment PIN_C18 -to hex1[0]
set_location_assignment PIN_D18 -to hex1[1]
set_location_assignment PIN_E18 -to hex1[2]
set_location_assignment PIN_B16 -to hex1[3]
set_location_assignment PIN_A17 -to hex1[4]
set_location_assignment PIN_A18 -to hex1[5]
set_location_assignment PIN_B17 -to hex1[6]

# Arquivo de restricoes de timing associado
set_global_assignment -name SDC_FILE max10_aging.sdc

# Arquivos de design (RTL)
set_global_assignment -name VERILOG_FILE ../rtl/top/max10_aging_top.sv
set_global_assignment -name VERILOG_FILE ../rtl/aging_sensor/aging_sensor_core.sv
set_global_assignment -name VERILOG_FILE ../rtl/aging_sensor/critical_path_chain.sv
set_global_assignment -name VERILOG_FILE ../rtl/aging_sensor/scc_controller.sv
set_global_assignment -name VERILOG_FILE ../rtl/uart/uart_tx.sv
set_global_assignment -name VERILOG_FILE ../rtl/uart/uart_packet_sender.sv
set_global_assignment -name VERILOG_FILE ../rtl/display/hex7seg.sv
# aging_pll.v e gerado pelo wizard da ALTPLL (IP Catalog) e nao versionado aqui
# -- ver hdl/README.md sobre reproducao da IP.
