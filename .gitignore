# ==============================================================================
# IC-Aging-Environment Central .gitignore
# ==============================================================================

# Antigravity & Claude metadata
.claude/
.gemini/

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# PyInstaller & packaging output
build/
*/build/
*/**/build/
dist/
*/dist/
*/**/dist/
*.spec.bak
*.pkg
*.toc

# ------------------------------------------------------------------------------
# Experimental Data & Logs
# (Keep data/sample_logs/ versioned for demos; ignore all other raw data)
# ------------------------------------------------------------------------------
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
!data/sample_logs/*.csv
!data/sample_logs/*.tsv

test_logs/
**/test_logs/
# data/campaigns/ is versioned on purpose (decision 2026-11-05): the raw logs behind
# the published papers. Every file there was already a blob in git history, so
# re-tracking it adds no repository size. New campaigns: see data/campaigns/README.md.
!data/campaigns/**/*.csv
data/local_runs/

# ------------------------------------------------------------------------------
# EDA Tools: Xilinx Vivado
# ------------------------------------------------------------------------------
.Xil/
**/.Xil/
*.jou
*.log
*.str
*.wdb
*.wdf
*.pb
*.rpx
*.dcp
*.mmi
*.runs/
**/*.runs/
*.gen/
**/*.gen/
*.cache/
**/*.cache/
*.hw/
**/*.hw/
*.sim/
**/*.sim/
*.ip_user_files/
**/*.ip_user_files/
**/artifacts/

# Preserve specific reference DCPs and production bitstreams if needed
!**/references/*.dcp
!**/bitstreams/*.bit
!**/bitstreams/*.ltx

# ------------------------------------------------------------------------------
# EDA Tools: Intel Quartus Prime (for MAX10 target)
# ------------------------------------------------------------------------------
db/
**/db/
incremental_db/
**/incremental_db/
output_files/
**/output_files/
*.qws
*.rpt
*.summary
*.done
*.jdi
*.pin
*.sof
*.pof

# ------------------------------------------------------------------------------
# Embedded Systems & IDEs (STM32CubeIDE / Eclipse / Arduino)
# ------------------------------------------------------------------------------
Debug/
**/Debug/
Release/
**/Release/
.metadata/
*.launch.local

# ------------------------------------------------------------------------------
# LaTeX Build Artifacts
# ------------------------------------------------------------------------------
*.aux
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.lof
*.lot

# ------------------------------------------------------------------------------
# OS & Editor Metadata
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.Rhistory
*.swp
*~
